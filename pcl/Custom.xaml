<StackPanel xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:sys="clr-namespace:System;assembly=mscorlib" xmlns:local="clr-namespace:PCL;assembly=Plain Craft Launcher 2" Background="#1e293b">
    <Border Background="#1e293b" Padding="20">
        <StackPanel>
            <!-- Title -->
            <TextBlock Text="mcYggdrasill" FontSize="24" FontWeight="Bold" Foreground="#22c55e" HorizontalAlignment="Center" Margin="0,0,0,5"/>
            <TextBlock Text="世界树服务器" FontSize="14" Foreground="#9ca3af" HorizontalAlignment="Center" Margin="0,0,0,20"/>
            
            <!-- Server Status Card -->
            <Border Background="#334155" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Stretch">
                        <TextBlock Text="服务器状态" Foreground="#9ca3af" FontSize="12"/>
                        <Border Background="#22c55e" CornerRadius="4" Padding="4,2,4,2" HorizontalAlignment="Right">
                            <TextBlock Text="在线" Foreground="#000" FontSize="11" FontWeight="Bold"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="IP: play.mcyggdrasill.com" Foreground="#e5e7eb" FontSize="12" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>
            
            <!-- Features -->
            <Border Background="#334155" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="服务器特色" Foreground="#f59e0b" FontSize="14" FontWeight="Bold" Margin="0,0,0,8"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <TextBlock Text="✓" Foreground="#22c55e" Margin="0,0,6,0"/>
                        <TextBlock Text="公益性服务器，永久免费" Foreground="#e5e7eb" FontSize="12"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <TextBlock Text="✓" Foreground="#22c55e" Margin="0,0,6,0"/>
                        <TextBlock Text="群组服玩法，多种模式" Foreground="#e5e7eb" FontSize="12"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="✓" Foreground="#22c55e" Margin="0,0,6,0"/>
                        <TextBlock Text="稳定运行，定期备份" Foreground="#e5e7eb" FontSize="12"/>
                    </StackPanel>
                </StackPanel>
            </Border>
            
            <!-- Announcement -->
            <Border Background="#334155" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="最新公告" Foreground="#f59e0b" FontSize="14" FontWeight="Bold" Margin="0,0,0,4"/>
                    <TextBlock Text="服务器运行正常，欢迎加入！" Foreground="#e5e7eb" FontSize="12"/>
                </StackPanel>
            </Border>
            
            <!-- Version -->
            <TextBlock Text="Version: v1.0.6 | mcYggdrasill" FontSize="10" Foreground="#64748b" HorizontalAlignment="Center"/>
        </StackPanel>
    </Border>
</StackPanel>